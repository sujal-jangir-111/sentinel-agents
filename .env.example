# Copy to .env and fill in. Never commit .env. On a host, set these as secret environment variables instead.

# --- Required ----------------------------------------------------------------------------------------

# LLM. Groq by default; a free key comes from https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# GitHub token. Reads public repositories. To open pull requests it needs Contents and
# Pull requests read/write on the repositories below.
GITHUB_TOKEN=
# The one repository Sentinel may open pull requests on, plus any others, comma-separated
DEMO_REPO_FULL_NAME=your-name/sentinel-target
GITHUB_WRITE_ALLOWLIST=

# Protects the bundled demo app's hotfix and chaos endpoints
DEMO_ADMIN_TOKEN=change-me

# Each agent's identity: five long, random, different values
ORCHESTRATOR_SEED=
WATCHDOG_SEED=
DETECTIVE_SEED=
SCANNER_SEED=
EXECUTOR_SEED=

# Password for the whole console. Required on any public host: without it the server refuses to start.
CONSOLE_PASSWORD=

# --- Optional ----------------------------------------------------------------------------------------

# GROQ_ASSISTANT_MODEL=             # a different model for the chat (default: GROQ_MODEL)
# GROQ_FALLBACK_MODEL=              # tried when the main model is unavailable
# LLM_CONTEXT_CHARS=6000            # code sent to the LLM to locate a bug (default: 6000 on Groq, 40000 otherwise)
# PATCH_MAX_ATTEMPTS=3              # gatekeeper retries for one fix
# WEB_HOST=127.0.0.1                # the Docker image sets 0.0.0.0
# WEB_PORT=8080                     # default: the host's PORT, then 8080
# DEMO_SERVICE_URL=http://127.0.0.1:9000
# GATEWAY_SEED=                     # default: derived from ORCHESTRATOR_SEED

# Gemini, if LLM_PROVIDER=gemini. Its free plan allows about 20 requests a day per model.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_ASSISTANT_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# --- Original hackathon path, off by default ------------------------------------------------------------

# ASI:One chat and Agentverse mailboxes: LLM_PROVIDER=asi1 and AGENT_MAILBOX=true
# ASI1_API_KEY=
# ASI1_MODEL=asi1-mini

# Testnet payment as change control. The web console never uses it.
# SKIP_PAYMENT=true
# ORCHESTRATOR_WALLET_ADDRESS=
# REMEDIATION_PRICE_ATESTFET=100000000000000000
# DORADO_EXPLORER_BASE=https://explore-dorado.fetch.ai/transactions

# Continuous watchdog polling and the card's impact estimate
# WATCHDOG_TARGETS=
# WATCHDOG_INTERVAL_SECONDS=60
# TRAFFIC_RPM=120
# AVG_ORDER_VALUE_USD=40
# CONVERSION_RATE=0.03
# SLA_TARGET=0.999
